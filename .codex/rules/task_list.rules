# Codex deny rules for local development benches. Copied from frappe-agent-kit templates/codex.rules;
# keep every prefix in step with .claude/settings.json;
# scripts/test_deny_rules.py fails when a prefix here has no Claude rule.

prefix_rule(
    pattern = ["bench", "show-config"],
    decision = "forbidden",
    justification = "Do not disclose site configuration or open a database console. See the agent rules in AGENTS.md.",
    match = ["bench show-config"],
    not_match = ["bench --site task-list-test.localhost migrate"],
)

